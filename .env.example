# Скопируйте в .env и заполните. .env в git не попадает.

# Адрес GET API хакатона (из PDF задания); &group_id=... в конце можно оставить
CQA_ORG_API_URL=

# Название команды для results.json
CQA_TEAM_NAME=Utopia

# Ключи провайдеров: нужны только те, чьи модели указаны ниже
CLAUDE_API_KEY=
GROQ_API_KEY=

# --- Основной режим: гибрид (облако + локальная модель) ---
# Claude Haiku 5.5 -> при отказе бесплатный Groq -> при отказе облака локальная Gemma (Ollama)
CQA_MODEL=anthropic/claude-haiku-5-5
CQA_FALLBACK_MODELS=groq/openai/gpt-oss-120b,ollama_chat/gemma4:e4b
CQA_PRICE_IN_PER_M=0.10
CQA_PRICE_OUT_PER_M=0.50
# Лимит запросов в минуту, 0 = без ограничения (платный ключ; лимиты Groq программа выдерживает сама)
CQA_RPM=0
# Пусто = как в чек-листе (шкалы c04 и c06 спрашиваются 3 раза, берётся медиана); 1 = без повторов, дешевле
CQA_RESAMPLE=

# Второе мнение по грубым ошибкам: найденную грубую ошибку перепроверяет более сильная модель.
# ~$0.015 только на диалог с грубой ошибкой. Пусто - выключено.
CQA_VERIFY_MODEL=anthropic/claude-sonnet-5-5
CQA_VERIFY_PRICE_IN_PER_M=2
CQA_VERIFY_PRICE_OUT_PER_M=10

# Ниже «нужна проверка» в интерфейсе
CQA_LOW_CONFIDENCE=0.7

# --- Только бесплатный облачный режим (Groq) ---
# CQA_MODEL=groq/openai/gpt-oss-120b
# CQA_FALLBACK_MODELS=ollama_chat/gemma4:e4b
# CQA_PRICE_IN_PER_M=0
# CQA_PRICE_OUT_PER_M=0
# CQA_RESAMPLE=1                 # бесплатный лимит Groq: 200 000 токенов в сутки на аккаунт
# CQA_VERIFY_MODEL=

# --- Полностью локальный режим: данные не покидают компьютер ---
# Ollama (https://ollama.com), затем: ollama pull gemma4:e4b
# CQA_MODEL=ollama_chat/gemma4:e4b
# CQA_FALLBACK_MODELS=
# CQA_PRICE_IN_PER_M=0
# CQA_PRICE_OUT_PER_M=0
# CQA_RESAMPLE=1
# CQA_VERIFY_MODEL=
# CQA_NUM_CTX=8192               # окно контекста (промпт ~5 000 токенов)
# CQA_LOCAL_THINK=0              # 1 = режим рассуждений: точнее, но в ~3 раза медленнее
