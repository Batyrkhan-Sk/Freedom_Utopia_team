# Скопируйте в .env и заполните. .env в git не попадает.

# Адрес GET организаторов (из PDF задания); &group_id=... в конце можно оставить
CQA_ORG_API_URL=

# Название команды для results.json
CQA_TEAM_NAME=Freedom Utopia

# Ключи провайдеров (нужен хотя бы один)
GEMINI_API_KEY=
GROQ_API_KEY=
CLAUDE_API_KEY=

# Модель и резерв (формат LiteLLM)
CQA_MODEL=gemini/gemini-3.5-flash
CQA_FALLBACK_MODELS=gemini/gemini-flash-latest
# Бесплатный Gemini: 5 запросов в минуту. Groq: можно 20-30. Платный тариф: 0 (без ограничения)
CQA_RPM=5
# 1 = без повторного опроса (для настройки, дешевле); пусто = как в чек-листе (3 для c04 и c06)
CQA_RESAMPLE=1

# Пример бесплатного варианта через Groq:
# CQA_MODEL=groq/openai/gpt-oss-120b
# CQA_FALLBACK_MODELS=groq/qwen/qwen3.8-27b
# CQA_RPM=20
